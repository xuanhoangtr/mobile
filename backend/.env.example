# Copy this file to .env (ignored by git) and fill in local values.
# Never commit real secrets or production credentials.

APP_ENV=dev
PORT=8080

# PostgreSQL (optional during skeleton stage; leave empty to run without DB)
DB_URL=jdbc:postgresql://localhost:5432/android_chat
DB_USER=postgres
DB_PASSWORD=change_me_locally

# JWT Configuration (set a strong random string locally; mandatory in prod)
JWT_SECRET=replace-with-local-dev-secret-at-least-32-chars
JWT_ISSUER=android-chat-backend
JWT_AUDIENCE=android-chat-clients
